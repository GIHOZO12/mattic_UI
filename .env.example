# Backend the Vite dev/preview proxy forwards /api and /media to (not exposed to the browser).
STOREFRONT_BACKEND_URL=https://mattic-production.up.railway.app
# Local backend: STOREFRONT_BACKEND_URL=http://127.0.0.1:8000
# Relative URL uses the proxy above in dev and same-origin hosting in production.
VITE_API_BASE_URL=/api/v1
# Separately hosted build (needs Django CORS for the frontend origin):
# VITE_API_BASE_URL=https://mattic-production.up.railway.app/api/v1
VITE_BRAND_NAME=Suit and Tie Fashion Shop
VITE_SITE_URL=https://suitandtiefashionshop.com
VITE_ANNOUNCEMENT=Considered style. Everyday confidence.

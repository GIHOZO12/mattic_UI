{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mattic-ui",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/sitemap.xml",
      "/products/*",
      "/shop/*"
    ]
  },
  "vars": {
    "BACKEND_URL": "https://mattic-production.up.railway.app",
    "SITE_URL": "https://suitandtiefashionshop.com"
  }
}
